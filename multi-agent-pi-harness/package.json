{
  "name": "multi-agent-pi-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Transport-neutral multi-agent runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "config/config.default.json",
    "dist"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "multi-agent-pi": "file:../multi-agent-pi"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.7.3"
  }
}
